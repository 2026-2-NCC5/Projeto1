# =============================================================================
# ARQUIVO DE EXEMPLO - ASA FECAP Frontend (.env.example)
# =============================================================================
# Copie este arquivo para .env e ajuste conforme necessário:
#   cp .env.example .env
#
# O Frontend NÃO precisa de chave da Groq.
# A chave da Groq deve estar exclusivamente no Backend/.env

# URL do Backend FastAPI (local ou produção)
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000

# Modelo Groq utilizado (informativo, seleção é feita pelo Backend)
EXPO_PUBLIC_GROQ_MODEL=qwen/qwen3.8-27b
