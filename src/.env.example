# =============================================================================
# SISA FECAP - VARIÁVEIS DE AMBIENTE PARA O RAILWAY (.env.example)
# =============================================================================
# Configure estas variáveis no painel do Railway (Variables do serviço):

# --- Configuração do Servidor FastAPI ---
HOST=0.0.0.0
PORT=8000
FASTAPI_ENV=production

# --- Credenciais do Groq (LLM) ---
GROQ_API_KEY=gsk_sua_chave_groq_aqui
GROQ_MODEL=qwen/qwen3.8-27b

# --- Supabase (Banco de Dados, Autenticação e Storage) ---
SUPABASE_URL=https://hevywbfvoooybuxxewwp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_aqui

# --- Frontend Expo / React Native Web (Injetadas em tempo de build) ---
EXPO_PUBLIC_SUPABASE_URL=https://hevywbfvoooybuxxewwp.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anon_aqui
EXPO_PUBLIC_GROQ_API_KEY=gsk_sua_chave_groq_aqui
EXPO_PUBLIC_GROQ_MODEL=qwen/qwen3.8-27b

# Opcional: Para deploy unificado, pode deixar vazio (utiliza rotas relativas na mesma origem)
EXPO_PUBLIC_BACKEND_URL=
EXPO_PUBLIC_AI_ENDPOINT_URL=/api
